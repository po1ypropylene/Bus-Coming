{
    "name": "bus-coming",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": "^22.19.0 || >=24.11.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "oxlint && eslint .",
        "preview": "vite preview",
        "test": "vitest run src && npm run test:toolchain",
        "test:e2e": "playwright test",
        "audit:apis": "node scripts/audit-apis.mjs",
        "icons": "node scripts/generate-icons.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:offline": "npm run build && node scripts/offline-smoke.mjs",
        "catalog:generate": "vite build --config scripts/citybus-tools.config.ts && node .catalog-tools/generate-citybus.mjs",
        "catalog:deploy": "wrangler deploy --config cloudflare/citybus.wrangler.jsonc",
        "catalog:test": "vite build --config scripts/citybus-tools.config.ts && node scripts/test-citybus-publisher.mjs",
        "typecheck": "tsc -b",
        "typecheck:watch": "tsc -b --watch",
        "test:toolchain": "node scripts/test-toolchain.mjs"
    },
    "dependencies": {
        "idb": "^8.0.4",
        "lucide-react": "^1.58.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@babel/core": "^8.0.7",
        "@babel/eslint-parser": "^8.0.7",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "lighthouse": "^13.5.0",
        "oxlint": "^1.88.0",
        "prettier": "^3.9.10",
        "puppeteer-core": "^25.14.0",
        "sharp": "^0.35.5",
        "typescript": "~7.0.2",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.1"
    }
}
