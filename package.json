{
    "name": "bus-coming",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run src",
        "test:e2e": "playwright test",
        "audit:apis": "node scripts/audit-apis.mjs",
        "icons": "node scripts/generate-icons.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:offline": "npm run build && node scripts/offline-smoke.mjs",
        "catalog:generate": "vite build --config scripts/citybus-tools.config.ts && node .catalog-tools/generate-citybus.mjs",
        "catalog:deploy": "wrangler deploy --config cloudflare/citybus.wrangler.jsonc",
        "catalog:test": "vite build --config scripts/citybus-tools.config.ts && node scripts/test-citybus-publisher.mjs"
    },
    "dependencies": {
        "idb": "^8.0.3",
        "lucide-react": "^1.47.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "prettier": "^3.9.8",
        "sharp": "^0.35.4",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.3.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^5.0.1",
        "wrangler": "^4.147.0"
    }
}
